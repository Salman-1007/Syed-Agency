<script>
    lucide.createIcons();

    // 1. Property Filtering Logic
    function filterProps(category) {
        const cards = document.querySelectorAll('.prop-card');
        const buttons = document.querySelectorAll('.filter-tab');

        buttons.forEach(btn => {
            btn.className = 'filter-tab px-4 py-2 rounded-lg text-xs font-bold bg-white border border-gray-200 text-slate-600 hover:bg-gray-50 transition';
        });
        event.target.className = 'filter-tab px-4 py-2 rounded-lg text-xs font-bold bg-brand-navy text-white transition';

        cards.forEach(card => {
            if (category === 'all' || card.classList.contains(category)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // 2. Interactive Calculator Logic
    function updateDownLabel(val) {
        document.getElementById('downLabel').innerText = val + "% Down Payment";
    }

    function calculatePlan() {
        const price = parseFloat(document.getElementById('calcPrice').value) || 0;
        const downPct = parseFloat(document.getElementById('calcDown').value) || 20;
        const years = parseInt(document.getElementById('calcYears').value) || 3;

        const downAmount = price * (downPct / 100);
        const remaining = price - downAmount;
        const totalQuarters = years * 4;
        const quarterly = remaining / totalQuarters;
        const projectedValue = price * 1.40;

        document.getElementById('resDown').innerText = "$" + downAmount.toLocaleString();
        document.getElementById('resQuarterly').innerText = "$" + Math.round(quarterly).toLocaleString() + " / qtr";
        document.getElementById('resGrowth').innerText = "$" + Math.round(projectedValue).toLocaleString() + " (+40%)";
    }

    // 3. Modal Details
    function openModal(title, price) {
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalPrice').innerText = price;
        document.getElementById('propModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('propModal').classList.add('hidden');
    }

    // 4. Inbound Lead Handling
    async function submitLead(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/api/inquire', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            alert(result.message);
            form.reset();
        } catch (err) {
            alert("Request registered! An agent will call you shortly.");
        }
    }
</script>
</body>

</html>